#pragma once
// <charconv> for GCC 7's libstdc++ (which predates it): integer from_chars /
// to_chars, the subset the runtime uses.

#include <system_error>
#include <limits>
#include <type_traits>

namespace std {

struct from_chars_result {
    const char* ptr;
    errc ec;
};

struct to_chars_result {
    char* ptr;
    errc ec;
};

namespace mkw_charconv {
inline int Digit(char c)
{
    if (c >= '0' && c <= '9')
        return c - '0';
    if (c >= 'a' && c <= 'z')
        return c - 'a' + 10;
    if (c >= 'A' && c <= 'Z')
        return c - 'A' + 10;
    return 99;
}
} // namespace mkw_charconv

template <class T, class = typename enable_if<is_integral<T>::value>::type>
inline from_chars_result from_chars(const char* first, const char* last, T& value, int base = 10)
{
    using U = typename make_unsigned<T>::type;
    const char* p = first;
    bool negative = false;
    if (is_signed<T>::value && p != last && *p == '-') {
        negative = true;
        ++p;
    }
    const char* digits = p;
    U result = 0;
    const U limit = negative ? static_cast<U>(static_cast<U>(-(numeric_limits<T>::min() + 1)) + 1u)
                             : static_cast<U>(numeric_limits<T>::max());
    bool overflow = false;
    for (; p != last; ++p) {
        const int d = mkw_charconv::Digit(*p);
        if (d >= base)
            break;
        if (result > (limit - static_cast<U>(d)) / static_cast<U>(base))
            overflow = true;
        else
            result = static_cast<U>(result * static_cast<U>(base) + static_cast<U>(d));
    }
    if (p == digits)
        return {first, errc::invalid_argument};
    if (overflow)
        return {p, errc::result_out_of_range};
    value = negative ? static_cast<T>(0 - result) : static_cast<T>(result);
    return {p, errc{}};
}

template <class T, class = typename enable_if<is_integral<T>::value>::type>
inline to_chars_result to_chars(char* first, char* last, T value, int base = 10)
{
    using U = typename make_unsigned<T>::type;
    char buf[72];
    int n = 0;
    bool negative = is_signed<T>::value && value < 0;
    U v = negative ? static_cast<U>(0 - static_cast<U>(value)) : static_cast<U>(value);
    do {
        const unsigned d = static_cast<unsigned>(v % static_cast<U>(base));
        buf[n++] = static_cast<char>(d < 10 ? '0' + d : 'a' + d - 10);
        v = static_cast<U>(v / static_cast<U>(base));
    } while (v);
    if (negative)
        buf[n++] = '-';
    if (last - first < n)
        return {last, errc::value_too_large};
    for (int i = 0; i < n; ++i)
        first[i] = buf[n - 1 - i];
    return {first + n, errc{}};
}

} // namespace std
